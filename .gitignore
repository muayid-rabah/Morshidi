.env
.env.*
!.env.example

# Node / Next.js
node_modules/
.next/
out/
dist/
build/

# Logs
*.log
logs/

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# IDE / Editor
.idea/

# VS Code local settings
.vscode/settings.json

# Supabase local files
supabase/.temp/
supabase/.branches/

# Local database files
*.db
*.sqlite
*.sqlite3

# Temporary files
*.tmp
*.temp
~$*

# Python package artifacts
*.egg-info/
.eggs/
wheels/
